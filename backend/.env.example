# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/deadlinehero

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRE=7d

# Email Service (Resend)
RESEND_API_KEY=re_your-api-key-here
EMAIL_FROM=onboarding@resend.dev

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI Configuration
# Get your Gemini API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use (configurable; default is gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Set to 'true' to use mock AI responses for demo/testing (no API key needed)
# Set to 'false' to use real Gemini API (requires a valid GEMINI_API_KEY)
AI_DEMO_MODE=true
